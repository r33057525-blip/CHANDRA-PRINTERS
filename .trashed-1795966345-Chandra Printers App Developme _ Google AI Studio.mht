<span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">PricingEngine</span> </span>{
  <span class="hljs-comment">/// Dynamic calculation based on size multipliers, material finish, and bulk tier discounts</span>
  <span class="hljs-function"><span class="hljs-keyword">static</span> <span class="hljs-keyword">double</span> <span class="hljs-title">calculatePrice</span><span class="hljs-params">({
    required Product product,
    required String selectedSize,
    required ProductOption selectedPaper,
    required ProductOption selectedFinish,
    required <span class="hljs-keyword">int</span> quantity,
  })</span> </span>{
    <span class="hljs-keyword">double</span> sizeMultiplier = <span class="hljs-number">1.0</span>;
    <span class="hljs-keyword">if</span> (selectedSize.contains(<span class="hljs-string">'A3'</span>) || selectedSize.contains(<span class="hljs-string">'Large'</span>) || selectedSize.contains(<span class="hljs-string">'12x18'</span>)) {
      sizeMultiplier = <span class="hljs-number">1.8</span>;
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (selectedSize.contains(<span class="hljs-string">'Banner'</span>) || selectedSize.contains(<span class="hljs-string">'Flex'</span>)) {
      sizeMultiplier = <span class="hljs-number">2.5</span>;
    }

    <span class="hljs-keyword">double</span> unitBase = (product.basePrice * sizeMultiplier) +
        selectedPaper.extraPricePerUnit +
        selectedFinish.extraPricePerUnit;

    <span class="hljs-comment">// Bulk tier discount calculation</span>
    <span class="hljs-keyword">double</span> discountPercentage = <span class="hljs-number">0.0</span>;
    <span class="hljs-keyword">if</span> (quantity &gt;= <span class="hljs-number">1000</span>) {
      discountPercentage = <span class="hljs-number">0.25</span>; <span class="hljs-comment">// 25% off bulk</span>
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (quantity &gt;= <span class="hljs-number">500</span>) {
      discountPercentage = <span class="hljs-number">0.18</span>; <span class="hljs-comment">// 18% off</span>
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (quantity &gt;= <span class="hljs-number">100</span>) {
      discountPercentage = <span class="hljs-number">0.10</span>; <span class="hljs-comment">// 10% off</span>
    }

    <span class="hljs-keyword">double</span> total = (unitBase * quantity) * (<span class="hljs-number">1.0</span> - discountPercentage);
    <span class="hljs-keyword">return</span> <span class="hljs-keyword">double</span>.parse(total.toStringAsFixed(<span class="hljs-number">2</span>));
  }
}</code></pre><!----><!----><!----><!----></div></div></div></mat-expansion-panel><!----></div><!----><!----><!----><!----><!----><!----><!----></ms-code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><hr _ngcontent-ng-c2452056902="" class="ng-star-inserted"><ms-cmark-node _ngcontent-ng-c2452056902="" _nghost-ng-c2452056902="" class="ng-star-inserted"><!----></ms-cmark-node><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><h3 _ngcontent-ng-c2452056902="" id="4-global-state-app-store-lib-providers-app_state-dart" class="ng-star-inserted"><ms-cmark-node _ngcontent-ng-c2452056902="" _nghost-ng-c2452056902=""><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><span _ngcontent-ng-c2452056902="" class="ng-star-inserted">4. Global State &amp; App Store: </span><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><span _ngcontent-ng-c2452056902="" class="inline-code ng-star-inserted">lib/providers/app_state.dart</span><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></ms-cmark-node></h3><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><ms-code-block _ngcontent-ng-c2452056902="" _nghost-ng-c3565183845="" data-test-language="dart" class="ng-star-inserted"><div _ngcontent-ng-c3565183845="" class="container"><mat-expansion-panel _ngcontent-ng-c3565183845="" clas